<%# A glyph for what the bulb is. icon: lamp | candle | spot | strip %>
<svg class="ico" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% if icon == "candle" %><rect x="6" y="7" width="6" height="9" rx="1"/><path d="M9 2c1.5 2 1.5 3 0 4-1.5-1-1.5-2 0-4z"/>
  <% elsif icon == "spot" %><path d="M4 3h10v3H4z"/><path d="M6 6l-1 4h8l-1-4"/><path d="M5 13l1 2M13 13l-1 2M9 13v2" opacity=".6"/>
  <% elsif icon == "strip" %><rect x="2" y="7" width="14" height="4" rx="2"/><circle cx="5" cy="9" r=".8" fill="currentColor"/><circle cx="9" cy="9" r=".8" fill="currentColor"/><circle cx="13" cy="9" r=".8" fill="currentColor"/>
  <% else %><path d="M5 3h8l2 7H3z"/><path d="M9 10v4M6 16h6"/>
  <% end %>
</svg>
