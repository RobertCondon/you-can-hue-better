<div class="<%= class_names("pin", light.lit? ? LightsHelper::ON_CLASS : LightsHelper::OFF_CLASS) %>" id="<%= targets.light_pin(light) %>" data-light-id="<%= light.id %>" data-brightness="<%= light.brightness.round %>"
     style="<%= pin_style(light) %>" <%= tag.attributes(data: power_looks(light) { |look| pin_style(look) }) %>
     data-controller="light pinned"
     data-action="pointerdown->pinned#swipeStart pointermove->pinned#swipeMove pointerup->pinned#swipeEnd pointercancel->pinned#swipeEnd click->pinned#guard:capture">
  <div class="pin__bar">
    <%= async_hue_form_with url: light_path(light.id), method: :patch, class: "pin__toggle", light_ids: [ light.id ] do |form| %>
      <button type="submit" name="light[on]" value="<%= !light.lit? %>" class="pin__icon" aria-pressed="<%= light.lit? %>" aria-label="<%= light_power_label(light) %>">
        <span class="tile__dot"><%= render "lights/icon", icon: light.icon %></span>
      </button>
    <% end %>
    <button type="button" class="pin__names" data-action="pinned#expand" aria-label="<%= t(".more_controls", light: light.display_name) %>">
      <span class="pin__name"><%= light.display_name %></span>
      <span class="pin__level" data-level><%= light.brightness_label %></span>
    </button>
    <%= async_hue_form_with url: light_path(light.id), method: :patch, class: "pin__dim", light_ids: [ light.id ] do |form| %>
      <label class="sr-only" for="pin_bri_<%= light.id %>"><%= t(".brightness_of", light: light.display_name) %></label>
      <input type="range" id="pin_bri_<%= light.id %>" name="light[brightness]" min="<%= Hue::Api::Limits::LIT_BRIGHTNESS.min %>" max="<%= Hue::Api::Limits::LIT_BRIGHTNESS.max %>"
             value="<%= slider_level(light) %>" data-action="input->light#preview change->light#submit">
    <% end %>
    <button type="button" class="pin__swatch" data-action="pinned#expand" aria-label="<%= t(".colour_of", light: light.display_name) %>"></button>
    <button type="button" class="pin__close" data-action="pinned#close" aria-label="<%= t(".unpin", light: light.display_name) %>">×</button>
  </div>
  <div class="pin__sheet">
    <%= render "lights/panel", light: %>
  </div>
</div>
