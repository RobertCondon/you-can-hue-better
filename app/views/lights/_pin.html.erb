<%# The pinned light: a bar that stays at the top while the page scrolls, with the full panel folded under it. %>
<div class="pin <%= light.lit? ? "is-on" : "is-off" %>" id="light_pin_<%= light.id %>" data-light-id="<%= light.id %>" data-brightness="<%= light.brightness.round %>"
     style="--hue: <%= light.hex %>; --ink: <%= light.tile_text_hex %>; --fill: <%= light.fill_pct %>%"
     data-controller="light pinned"
     data-action="pointerdown->pinned#swipeStart pointermove->pinned#swipeMove pointerup->pinned#swipeEnd pointercancel->pinned#swipeEnd click->pinned#guard:capture">
  <div class="pin__bar">
    <%= form_with url: light_path(light.id), method: :patch, class: "pin__toggle" do |f| %>
      <button type="submit" name="light[on]" value="toggle" class="pin__icon" aria-pressed="<%= light.lit? %>" aria-label="<%= light.lit? ? "Turn off" : "Turn on" %> <%= light.display_name %>">
        <span class="tile__dot"><%= render "lights/icon", icon: light.icon %></span>
      </button>
    <% end %>
    <button type="button" class="pin__names" data-action="pinned#expand" aria-label="More controls for <%= light.display_name %>">
      <span class="pin__name"><%= light.display_name %></span>
      <span class="pin__level" data-level><%= light.brightness_label %></span>
    </button>
    <%= form_with url: light_path(light.id), method: :patch, class: "pin__dim" do |f| %>
      <label class="sr-only" for="pin_bri_<%= light.id %>">Brightness of <%= light.display_name %></label>
      <input type="range" id="pin_bri_<%= light.id %>" name="light[brightness]" min="1" max="100"
             value="<%= light.lit? ? light.brightness.round : 0 %>" data-action="input->light#preview change->light#submit">
    <% end %>
    <button type="button" class="pin__swatch" data-action="pinned#expand" aria-label="Colour of <%= light.display_name %>"></button>
    <button type="button" class="pin__close" data-action="pinned#close" aria-label="Unpin <%= light.display_name %>">×</button>
  </div>
  <div class="pin__sheet">
    <%= render "lights/panel", light: %>
  </div>
</div>
