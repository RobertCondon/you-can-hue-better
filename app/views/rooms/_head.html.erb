<div class="room__head" id="<%= targets.room_head(room) %>">
  <button type="button" class="room__title" data-action="room#toggle" aria-expanded="true" aria-controls="<%= targets.room(room) %>">
    <%= render "shared/icons/chevron" %>
    <span class="room__names">
      <% if room.nicknamed? %><small class="room__realname"><%= room.name %></small><% end %>
      <h2><%= room.display_name %><%= room_badges(room) %></h2>
    </span>
    <span class="room__summary"><%= room.summary %></span>
  </button>
  <div class="room__editing">
    <button type="button" class="btn btn--small"
            data-action="editor#open" data-editor-url-param="<%= room_names_path(room.id) %>" data-editor-kind-param="room"
            data-editor-title-param="<%= room.name %>" data-editor-name-param="<%= room.name %>" data-editor-nickname-param="<%= room.nickname %>"><%= t(".rename") %></button>
    <button type="button" class="btn btn--icon" data-action="rooms#moveUp" aria-label="<%= t(".move_up", room: room.display_name) %>">▲</button>
    <button type="button" class="btn btn--icon" data-action="rooms#moveDown" aria-label="<%= t(".move_down", room: room.display_name) %>">▼</button>
  </div>
  <%= form_with url: room_path(room.id), method: :patch, class: "room__toggle" do |form| %>
    <input type="hidden" name="room[on]" value="<%= room_power_target_state(room) %>">
    <button type="submit" class="<%= class_names("btn btn--icon", LightsHelper::ON_CLASS => room.any_on?) %>" aria-label="<%= room_power_label(room) %>" title="<%= room_power_title(room) %>">
      <%= render "shared/icons/power" %>
    </button>
  <% end %>
</div>
