<div class="room__body" id="<%= targets.room_body(room) %>" data-room-id="<%= room.id %>">
  <% if room.lights.any? %>
    <div class="scenes">
      <% room.scenes.each do |scene| %>
        <%= async_hue_button_to scene.name, activate_scene_path(scene.id), light_ids: scene.light_ids, class: "chip", form: { class: "chip-form", data: scene_set_data(scene.targets) } %>
      <% end %>
      <% room.custom_scenes.each do |scene| %>
        <%= async_hue_button_to scene.name, custom_scene_activation_path(scene.id), light_ids: scene.light_ids, class: "chip chip--custom",
                                title: t("rooms.room.your_scene", name: scene.name), form: { class: "chip-form", data: custom_scene_chip_data(scene) } %>
      <% end %>
      <button type="button" class="chip chip--add" data-action="custom-scene-dialog#open" data-custom-scene-dialog-url-param="<%= new_html_custom_scene_path(group_id: room.id) %>"
              aria-label="<%= t("rooms.room.save_scene", room: room.display_name) %>" title="<%= t("rooms.room.save_scene", room: room.display_name) %>">+</button>
    </div>
  <% end %>
  <div class="tiles">
    <% room.lights.each do |light| %>
      <%= render "lights/light", light:, room: %>
    <% end %>
  </div>
</div>
