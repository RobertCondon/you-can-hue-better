<section class="<%= class_names("room-card", "room-card--#{room.kind}", LightsHelper::ON_CLASS => room.any_on?) %>" id="<%= targets.room_card(room) %>" aria-label="<%= room.display_name %>"
         data-room-id="<%= room.id %>" data-room-pager-target="card">
  <div class="room-card__head">
    <div class="room-card__title">
      <span class="room-card__names">
        <% if room.nicknamed? %><small class="room-card__realname"><%= room.name %></small><% end %>
        <h2><%= room.display_name %><%= room_badges(room, badge_class: "room-card__kind") %></h2>
        <span class="room-card__summary"><%= room.summary %><% if room.any_on? %> · <%= room.brightness_label %><% end %></span>
      </span>
    </div>
    <%= async_hue_form_with url: room_path(room.id), method: :patch, class: "room-card__toggle", light_ids: room.lights.map(&:id) do |form| %>
      <input type="hidden" name="room[on]" value="<%= room_power_target_state(room) %>">
      <button type="submit" class="room-card__switch" role="switch" aria-checked="<%= room.any_on? %>" aria-label="<%= room_switch_label(room) %>">
        <span class="room-card__track" aria-hidden="true"></span>
      </button>
    <% end %>
  </div>
  <%= render "rooms/dots", room: room if room.lights.any? %>
  <% if room.visible_lights.any? %>
    <%= async_hue_form_with url: room_path(room.id), method: :patch, class: class_names("room-card__dim", RoomsHelper::MIXED_CLASS => room.mixed_brightness?), light_ids: room.lights.map(&:id),
                            html: { style: css_variables(fill: "#{room.any_on? ? room.level : 0}%") },
                            data: { controller: "room-brightness", action: "hue:freed@document->room-brightness#freed" } do |form| %>
      <label class="sr-only" for="room_bri_<%= room.id %>"><%= t(".brightness_of", room: room.display_name) %></label>
      <input type="range" id="room_bri_<%= room.id %>" name="room[brightness]" min="<%= Hue::Api::Limits::LIT_BRIGHTNESS.min %>" max="<%= Hue::Api::Limits::LIT_BRIGHTNESS.max %>"
             value="<%= room.level %>" data-action="input->room-brightness#preview change->room-brightness#submit">
      <output for="room_bri_<%= room.id %>" data-room-brightness-target="level"><%= room.brightness_label %></output>
    <% end %>
  <% end %>
</section>
