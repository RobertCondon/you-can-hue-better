<%# The app's main views. current: :lights | :scenes | :floor. On a phone this is the bottom tab bar. %>
<% icons = {
     lights: '<path d="M7 2.5a4 4 0 0 0-2.4 7.2c.5.4.9 1 .9 1.6v.2h3v-.2c0-.6.4-1.2.9-1.6A4 4 0 0 0 7 2.5zM5.8 13h2.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
     scenes: '<circle cx="4" cy="7" r="2" fill="currentColor"/><circle cx="10" cy="7" r="2" fill="currentColor" opacity="0.7"/><circle cx="7" cy="7" r="2" fill="currentColor" opacity="0.4"/>',
     floor:  '<path d="M1.5 1.5h11v11h-11zM1.5 7h6M7.5 1.5V7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>'
   } %>
<nav class="views" aria-label="Views">
  <% { lights: [ "Lights", root_path ], scenes: [ "Scenes", scenes_path ], floor: [ "Floor", floor_path ] }.each do |key, (label, path)| %>
    <%= link_to path, class: "views__link #{"is-current" if current == key}", "aria-current": current == key ? "page" : nil do %>
      <svg class="views__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><%= icons[key].html_safe %></svg><span><%= label %></span>
    <% end %>
  <% end %>
</nav>
