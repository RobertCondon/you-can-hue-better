<nav class="views" aria-label="<%= t(".label") %>">
  <% navigation_items.each do |view, path| %>
    <%= link_to path, class: navigation_link_class(view, current), "aria-current": navigation_aria_current(view, current) do %>
      <svg class="views__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><%= render "shared/icons/#{view}" %></svg><span><%= t(".#{view}") %></span>
    <% end %>
  <% end %>
</nav>
