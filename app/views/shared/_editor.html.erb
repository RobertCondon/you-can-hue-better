<dialog class="editor" data-editor-target="dialog">
  <%= form_with url: "#", method: :patch, data: { editor_target: "form", action: "turbo:submit-end->editor#submitted" } do |form| %>
    <p class="editor__title" data-editor-target="title"></p>
    <% if bridge_names %>
      <label class="editor__field">
        <span><%= t(".name") %></span>
        <input type="text" maxlength="<%= Hue::Resources::Renamable::MAX_NAME_LENGTH %>" required data-editor-target="name">
        <small><%= t(".name_hint") %></small>
      </label>
    <% end %>
    <label class="editor__field">
      <span><%= t(".nickname") %></span>
      <input type="text" maxlength="<%= HueExtensions::Record::MAX_NICKNAME_LENGTH %>" data-editor-target="nickname" placeholder="<%= t(".nickname_placeholder") %>">
      <small><%= t(".nickname_hint") %></small>
    </label>
    <p id="<%= targets.editor_error %>" class="editor__error" role="alert"></p>
    <div class="editor__actions">
      <button type="button" class="btn" data-action="editor#close"><%= t(".cancel") %></button>
      <button type="submit" class="btn btn--primary"><%= t(".save") %></button>
    </div>
  <% end %>
</dialog>
