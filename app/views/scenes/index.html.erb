<% content_for :title, t(".title") %>
<%= turbo_stream_from HouseBroadcast::STREAM %>
<header class="house">
  <h1><%= t(".title") %></h1>
  <div class="house__meta">
    <%= render "shared/nav", current: :scenes %>
  </div>
</header>

<main class="scenes-page">
  <% @rooms.each do |room| %>
    <% scenes = @scenes_by_room.fetch(room.id, []) %>
    <% next if scenes.empty? %>
    <section class="room">
      <div class="room__head">
        <span class="room__names">
          <% if room.nicknamed? %><small class="room__realname"><%= room.name %></small><% end %>
          <h2><%= room.display_name %><% if room.kind == Hue::Group::ZONE %> <span class="room__kind"><%= t("rooms.badges.zone") %></span><% end %></h2>
        </span>
      </div>
      <div class="scene-cards">
        <%= render partial: "scenes/card", collection: scenes, as: :scene %>
      </div>
    </section>
  <% end %>
</main>
