<article class="<%= class_names("scene-card", "is-active" => scene.active?, "is-playing" => scene.playing?) %>" id="<%= targets.scene_card(scene) %>"
         style="<%= palette_style(scene.palette_hexes) %>">
  <%= link_to scene_path(scene), class: "scene-card__body" do %>
    <span class="scene-card__title">
      <span class="scene-card__name"><%= scene.display_name %></span>
      <% if scene.playing? %><span class="badge"><%= t(".playing") %></span><% elsif scene.active? %><span class="badge badge--quiet"><%= t(".on") %></span><% end %>
    </span>
    <span class="dots" aria-label="<%= t(".lights", count: scene.actions.size) %>">
      <% scene.actions.sort_by(&:hue_angle).each do |action| %>
        <span class="dot" style="<%= css_variables(c: scene_dot_hex(action)) %>" title="<%= scene_light_name(action) %>"></span>
      <% end %>
    </span>
    <% if (other_rooms = sibling_room_names(scene)).any? %>
      <small class="muted"><%= t(".also_in", rooms: other_rooms.to_sentence) %></small>
    <% end %>
  <% end %>
  <div class="scene-card__actions">
    <%= async_hue_button_to t(".set"), activate_scene_path(scene.id), light_ids: scene_light_ids(scene), class: "chip", form: { class: "chip-form", data: scene_set_data(scene_targets(scene)) } %>
    <% if scene.dynamic? %>
      <%= async_hue_button_to t(".play"), play_scene_path(scene.id), light_ids: scene_light_ids(scene), class: "chip", form: { class: "chip-form" } %>
    <% end %>
  </div>
</article>
