<%= form_with url: custom_scenes_path, scope: :custom_scene, data: { action: "turbo:submit-end->custom-scene-dialog#submitted" } do |form| %>
  <p class="editor__title"><%= t(".title", room: @room.display_name) %></p>
  <p class="muted custom-scene__hint"><%= t(".hint") %></p>
  <ul class="custom-scene__lights">
    <% @room.lights.each do |light| %>
      <li class="<%= class_names("custom-scene__light", light_state_class(light)) %>">
        <span class="custom-scene__swatch" style="<%= css_variables(hue: light.hex) %>" aria-hidden="true"></span>
        <span class="custom-scene__name"><%= light.display_name %></span>
        <span class="custom-scene__level"><%= light.brightness_label %></span>
      </li>
    <% end %>
  </ul>
  <label class="editor__field">
    <span><%= t(".name") %></span>
    <%= form.text_field :name, required: true, maxlength: CustomSceneHelper::NAME_LENGTH, autocomplete: "off", data: { custom_scene_dialog_target: "name" } %>
  </label>
  <%= form.hidden_field :group_id, value: @room.id %>
  <p id="<%= CustomScenesController::ERROR_TARGET %>" class="editor__error" role="alert"></p>
  <div class="editor__actions">
    <button type="button" class="btn" data-action="custom-scene-dialog#close"><%= t(".cancel") %></button>
    <button type="submit" class="btn btn--primary"><%= t(".save") %></button>
  </div>
<% end %>
