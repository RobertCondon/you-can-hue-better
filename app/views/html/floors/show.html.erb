<% content_for :title, t(".title") %>
<%= turbo_stream_from HouseBroadcast::STREAM %>
<header class="house">
  <h1><%= t(".title") %></h1>
  <div class="house__meta">
    <div id="<%= targets.house_summary %>"><%= render "dashboard/summary", house: @house %></div>
    <%= render "shared/nav", current: :floor %>
  </div>
</header>
<main data-controller="editor">
  <%= render "floors/floor", floor: @floor, editable: true, rooms: @rooms, scenes: @scenes %>
  <%= render "shared/editor", bridge_names: false %>
</main>
