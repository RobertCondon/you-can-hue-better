<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Lights" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#1c2130">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div id="flash">
      <%= render "shared/flash", message: flash[:alert] if flash[:alert] %>
      <%= render "shared/flash", message: flash[:notice], tone: "done" if flash[:notice] %>
    </div>
    <%= yield %>
  </body>
</html>
