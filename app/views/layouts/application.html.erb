<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || t(".default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="<%= ApplicationHelper::THEME_COLOR %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% ApplicationHelper::FONT_HOSTS.each do |font_host| %>
      <link rel="preconnect" href="<%= font_host %>" crossorigin>
    <% end %>
    <link href="<%= ApplicationHelper::FONT_STYLESHEET %>" rel="stylesheet">
    <meta name="light-constants" content="<%= light_constants.to_json %>">
    <style><%= light_colour_tokens %></style>
    <%= stylesheet_link_tag(*ApplicationHelper::STYLESHEETS, "data-turbo-track": "reload") %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div id="<%= targets.flash %>">
      <%= render "shared/flash", message: flash[:alert] if flash[:alert] %>
      <%= render "shared/flash", message: flash[:notice], tone: ToastStreams::DONE_TONE if flash[:notice] %>
    </div>
    <%= yield %>
  </body>
</html>
