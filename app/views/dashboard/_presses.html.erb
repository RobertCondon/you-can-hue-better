<% if presses.empty? %>
  <p class="muted"><%= t(".none") %></p>
<% else %>
  <ol>
    <% presses.each do |control_event| %>
      <li>
        <span class="when"><%= clock_time(control_event.occurred_at) %></span>
        <span><%= control_event.control.label %></span>
        <span class="what"><%= press_description(control_event) %></span>
      </li>
    <% end %>
  </ol>
<% end %>
