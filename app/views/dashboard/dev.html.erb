<% content_for :title, t(".title") %>
<%= turbo_stream_from HouseBroadcast::STREAM %>
<div data-controller="rooms editor" data-rooms-url-value="<%= order_rooms_path %>">
  <%= render "dashboard/lights", house: @house, state: @state, dev: true %>
  <%= render "dashboard/visibility", house: @house %>

  <aside class="activity">
    <div class="activity__col">
      <h2><%= t(".recent_changes") %></h2>
      <% if @activities.empty? %>
        <p class="muted"><%= t(".no_changes") %></p>
      <% else %>
        <ol>
          <%= render partial: "activities/activity", collection: @activities %>
        </ol>
      <% end %>
    </div>
    <div class="activity__col">
      <h2><%= t(".recent_presses") %></h2>
      <div id="<%= targets.recent_presses %>"><%= render "dashboard/presses", presses: @presses %></div>
    </div>
  </aside>
</div>
