<% content_for :title, t(".title") %>
<header class="house">
  <h1><%= t("dashboard.lights.title") %></h1>
</header>
<main class="setup">
  <% if @config.configured? %>
    <p class="setup__current"><%= t(".connected_html", bridge: tag.strong(@config.bridge), source: tag.span("(#{t(".source.#{@config.source}")})", class: "muted")) %>
      <%= t(@config.source == :environment ? ".pairing_again_environment" : ".pairing_again") %></p>
  <% else %>
    <h2><%= t(".heading") %></h2>
    <p><%= t(".explanation") %></p>
  <% end %>

  <%= form_with url: setup_path, method: :post, class: "setup__form", data: { controller: "bridge-choice" } do |form| %>
    <label for="setup_bridge"><%= t(".bridge_address") %></label>
    <div class="setup__row">
      <input type="text" id="setup_bridge" name="bridge" value="<%= @bridge_address %>" inputmode="decimal" autocomplete="off" placeholder="<%= t(".address_placeholder") %>" required data-bridge-choice-target="address">
      <% if @discovered_bridges.size > 1 %>
        <select aria-label="<%= t(".bridges_found") %>" data-action="bridge-choice#choose">
          <% @discovered_bridges.each do |bridge| %><option value="<%= bridge.address %>" <%= "selected" if bridge.address == @bridge_address %>><%= bridge.address %> (<%= bridge.id %>)</option><% end %>
        </select>
      <% end %>
    </div>
    <p class="muted setup__hint"><%= t(@discovered_bridges.any? ? ".found" : ".not_found") %></p>
    <ol class="setup__steps">
      <li><%= t(".press_button") %></li>
      <li><%= t(".then_connect", seconds: Hue::LinkButtonPairing::PAIRING_WINDOW_SECONDS) %></li>
    </ol>
    <button type="submit" class="btn btn--primary setup__go"><%= t(".connect") %></button>
  <% end %>
</main>
