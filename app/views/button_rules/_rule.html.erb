<% first = rule_counter.zero? %>
<li id="<%= dom_id(rule) %>" class="<%= class_names("button-rule", "is-missing": rule.missing?) %>">
  <%= form_with url: button_rule_path(rule), method: :patch, scope: :button_rule, class: "button-rule__form",
                data: { controller: "json-form autosave", action: "submit->json-form#submit change->autosave#save" } do |form| %>
    <div class="button-rule__clause">
      <span class="button-rule__word"><%= t(first ? ".if" : ".else_if") %></span>
      <%= form.select :if_subject, grouped_options_for_select(choices.subjects, ButtonRules::SubjectKey.dump(rule.if_subject_type, rule.if_subject_id)),
                      { include_blank: t(first ? ".always" : ".otherwise") }, id: dom_id(rule, :if_subject), "aria-label": t(".if_room") %>
      <% unless rule.always? %>
        <span><%= t(".is") %></span>
        <%= form.select :if_state, ButtonRule::STATES.map { |state| [ t(".states.#{state}"), state ] }, { selected: rule.if_state },
                        id: dom_id(rule, :if_state), "aria-label": t(".if_state") %>
      <% end %>
    </div>
    <div class="button-rule__clause">
      <span class="button-rule__word"><%= t(".then") %></span>
      <%= form.select :action, ButtonRule::ACTIONS.map { |action| [ t(".actions.#{action}"), action ] }, { selected: rule.action },
                      id: dom_id(rule, :action), "aria-label": t(".action") %>
      <%= form.select :target, grouped_options_for_select(choices.subjects(rooms_only: rule.recalls_scene? && rule.targets_room?), ButtonRules::SubjectKey.dump(rule.target_type, rule.target_id)),
                      {}, id: dom_id(rule, :target), "aria-label": t(".room") %>
      <% if rule.recalls_scene? && rule.targets_room? %>
        <span><%= t(".to") %></span>
        <%= form.select :scene_id, choices.scenes_in(rule.target_id), { selected: rule.scene_id },
                        id: dom_id(rule, :scene), "aria-label": t(".scene") %>
      <% elsif rule.sets_brightness? %>
        <span><%= t(".to") %></span>
        <span class="button-rule__level">
          <%= form.number_field :brightness, value: rule.brightness, in: Hue::Api::Limits::LIT_BRIGHTNESS, step: 1,
                                id: dom_id(rule, :brightness), "aria-label": t(".brightness") %><%= t(".percent") %>
        </span>
      <% end %>
    </div>
    <p class="button-rule__error" role="alert" data-json-form-target="error"><%= t(".missing") if rule.missing? %></p>
  <% end %>

  <div class="button-rule__tools">
    <% [ [ ButtonRule::UP, "↑", first ], [ ButtonRule::DOWN, "↓", rule_counter == last_index ] ].each do |direction, arrow, disabled| %>
      <%= form_with url: move_button_rule_path(rule), method: :patch, data: { controller: "json-form", action: "submit->json-form#submit" } do |form| %>
        <%= hidden_field_tag :direction, direction, id: dom_id(rule, "move_#{direction}") %>
        <button type="submit" class="button-rule__tool" aria-label="<%= t(".move_#{direction}") %>" title="<%= t(".move_#{direction}") %>" <%= "disabled" if disabled %>><%= arrow %></button>
      <% end %>
    <% end %>
    <%= form_with url: button_rule_path(rule), method: :delete, data: { controller: "json-form", action: "submit->json-form#submit" } do %>
      <button type="submit" class="button-rule__tool" aria-label="<%= t(".remove") %>" title="<%= t(".remove") %>">✕</button>
    <% end %>
  </div>
</li>
