<% rooms = local_assigns.fetch(:rooms, []) %>
<div class="floor-wrap" data-controller="floor" data-action="pinned:close->floor#dockClosed"
     data-floor-url-value="<%= floor_path %>" data-floor-objects-url-value="<%= floor_objects_path %>" data-floor-nets-url-value="<%= floor_nets_path %>" data-floor-paint-url-value="<%= floor_paint_path %>"
     data-floor-aspect-value="<%= floor.aspect %>">
  <% if editable %>
    <%= render "floors/filters", rooms:, scenes: local_assigns.fetch(:scenes, {}) if rooms.any? %>
    <%= render "floors/toolbar", floor:, rooms: %>
    <%= render "floors/paint_tray" %>
    <div class="dock dock--floor" id="<%= targets.light_dock %>" data-floor-target="dock" hidden></div>
  <% end %>
  <%= render "floors/map", floor:, editable: %>
  <% if editable %>
    <div class="floor__popover" data-floor-target="popover" hidden>
      <button type="button" class="floor__popover-close" aria-label="<%= t(".close") %>" data-action="floor#closeLight">×</button>
      <div data-floor-target="popoverBody"></div>
    </div>
  <% end %>
</div>
