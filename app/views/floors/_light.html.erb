<% light = spot.light; bri = light.lit? ? light.brightness / 100.0 : 0 %>
<button type="button" class="floor__lamp <%= light.lit? ? "is-on" : "is-off" %> <%= "is-unreachable" unless light.responding? %> <%= "is-unplaced" unless spot.placed %> <%= "is-muted" if spot.muted %>"
        id="floor_light_<%= light.id %>" data-light-id="<%= light.id %>" data-rooms="<%= spot.room_ids.join(" ") %>" data-floor-target="light"
        style="--x: <%= spot.x %>; --y: <%= spot.y %>; --hue: <%= light.hex %>; --bri: <%= bri.round(2) %>; --ink: <%= light.tile_text_hex %>"
        data-action="pointerdown->floor#down pointermove->floor#move pointerup->floor#up pointercancel->floor#up keydown->floor#nudge click->floor#openLight"
        data-floor-panel-url-param="<%= panel_light_path(light.id) %>"
        aria-label="<%= light.display_name %>, <%= spot.muted ? "not in this scene" : light.brightness_label %>">
  <span class="floor__dot" aria-hidden="true"><%= render "lights/icon", icon: light.icon %></span>
  <span class="floor__name"><%= light.display_name %></span>
</button>
